# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# freebuff preview/logs
.freebuff/
# QA measurement & audit scratch (generated during verification runs)
/.measure/
/.lh/
/.opencode/
/.audit/*.png
/.audit/*.jpg
/.audit/v2/
/.audit/v3/
# screenshot evidence from a UI pass (same rule, one level deeper)
/.audit/*/
!/.audit/images.json

# order-notification previews written by ORDER_CHANNELS_MODE=log
/.tmp/
# QA scratch (probes, screenshots, contact sheets)
/.qa/

# playwright output (screenshots under e2e/__screenshots__ stay tracked)
/playwright-report/
/playwright-results/
